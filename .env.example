# ── Base de données : Turso (libSQL) ────────────────────────────────────────
# turso db show dettik-db --url
# turso db tokens create dettik-db
TURSO_DATABASE_URL=libsql://dettik-db-votre-org.turso.io
TURSO_AUTH_TOKEN=votre-token-turso

# ── Authentification : Clerk ────────────────────────────────────────────────
# Tableau de bord Clerk > API keys
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_votre-cle
CLERK_SECRET_KEY=sk_test_votre-cle
# Tableau de bord Clerk > Webhooks (endpoint /api/webhooks/clerk)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_votre-secret

# ── Fichiers preuves : Vercel Blob ──────────────────────────────────────────
# Tableau de bord Vercel > Storage > Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_votre-token
