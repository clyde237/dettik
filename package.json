{
	"name": "dettik",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"db:schema": "node --env-file=.env scripts/apply-schema.mjs",
		"migrate:export": "node --env-file=.env scripts/export-supabase.mjs",
		"migrate:csv": "node scripts/csv-to-users.mjs",
		"migrate:csv-tables": "node scripts/csv-to-tables.mjs",
		"migrate:users": "node --env-file=.env scripts/import-clerk-users.mjs",
		"migrate:data": "node --env-file=.env scripts/import-turso.mjs",
		"migrate:proofs": "node --env-file=.env scripts/migrate-proofs.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"pg": "^8.22.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"sharp": "^0.34.5",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@libsql/client": "^0.17.4",
		"@lucide/svelte": "^0.564.0",
		"@vercel/blob": "^2.6.1",
		"idb": "^8.0.3",
		"svelte-clerk": "^1.1.11",
		"zod": "^4.3.6"
	}
}
